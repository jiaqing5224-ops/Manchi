{
    "name": "export_excel",
    "display_name": "导出 Excel",
    "description": "将上游数据（list[dict]）写入带样式的 Excel 文件到产物目录，并透传数据给下一节点。",
    "version": "1.0.0",
    "author": "",
    "source": "custom",
    "type": "output",
    "input_requirement": "any",
    "output_type": "any",
    "requires": ["openpyxl"],
    "params": {
        "columns": {
            "type": "string",
            "label": "导出列",
            "default": "",
            "required": false,
            "description": "要导出的列名，逗号分隔；留空则导出全部列"
        },
        "filename": {
            "type": "string",
            "label": "文件名",
            "default": "",
            "required": false,
            "description": "输出 Excel 文件名，留空则自动生成"
        }
    }
}
