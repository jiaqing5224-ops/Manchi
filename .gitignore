# =====================
# Python
# =====================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.Python

# Backend build artifacts (can be regenerated by build_backend.py)
backend/build/
backend/dist/
backend/manchi-backend.spec

# Database files (runtime data, auto-created)
backend/data/*.db

# =====================
# Node.js / Frontend
# =====================
node_modules/
frontend/manchi-ui/out/
frontend/manchi-ui/dist/
*.tsbuildinfo

# Electron vite temp configs
electron.vite.config.*.mjs

# =====================
# Environment files
# =====================
.env
.env.local

# =====================
# IDE / Editor
# =====================
.vscode/
.idea/
.trae/
.claude/

# =====================
# OS generated files
# =====================
.DS_Store
Thumbs.db
Desktop.ini

# =====================
# Archives
# =====================
*.zip
*.7z
*.tar.gz
*.rar

# =====================
# Logs
# =====================
*.log

# NOTE: .build-cache/ is NOT ignored — it contains pre-downloaded
# electron-builder binaries (winCodeSign, NSIS) for offline builds.

# Windows special files
nul
